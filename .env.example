# Server Configuration
PORT=3001

# Administrative Key (Required for autonomous monitoring testbench & administrative mutations)
ADMIN_API_KEY=

# AWS Credentials & Region (Optional for local testing; when set, live AWS is used)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS DynamoDB Table
DYNAMODB_TABLE_NAME=AirQualityReadings

# Amazon Bedrock Model ID
# Recommended fast & cost-effective models:
# anthropic.claude-3-haiku-20240307-v1:0 OR amazon.titan-text-express-v1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# AWS SageMaker 48-Hour Forecasting Endpoint
SAGEMAKER_ENDPOINT_NAME=delhi-aqi-xgboost-endpoint

# AWS SES Verified Email Sender
SES_SOURCE_EMAIL=

# Autonomous Atmospheric Shield Thresholds (µg/m³)
ADVISORY_THRESHOLD_PM25=75
BLOCK_EMERGENCY_THRESHOLD_PM25=250

# Google Gemini API Key (Bilingual petition polishing & localized health advisories)
GEMINI_API_KEY=

# Mapbox GL Public Access Token
VITE_MAPBOX_TOKEN=


