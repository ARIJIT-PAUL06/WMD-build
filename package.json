    "@aws-sdk/client-sagemaker": "^3.1147.0",
    "@aws-sdk/client-sagemaker-runtime": "^3.1146.0",
    "@aws-sdk/client-ses": "^3.1146.0",
    "@aws-sdk/lib-dynamodb": "^3.1143.0",
    "@codegenie/serverless-express": "^5.0.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "aws-amplify": "^6.22.1",
    "aws-jwt-verify": "^5.2.1",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "d3-array": "^3.2.4",
    "d3-contour": "^4.0.2",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "gsap": "^3.15.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.49.0",
    "mapbox-gl": "^3.32.0",
    "maplibre-gl": "^6.11.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
