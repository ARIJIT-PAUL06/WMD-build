{
  "name": "wmd",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"API,VITE\" -c \"cyan,magenta\" \"node --watch-path=server server/index.js\" \"vite\"",
    "dev:frontend": "vite",
    "dev:server": "node --watch-path=server server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:monitor": "node scripts/test_autonomous_monitor.js",
    "build:lambda": "node scripts/build_lambda.mjs",
    "sync:buffer": "node scripts/sync_buffer.js",
    "export:android": "npm --prefix mobile run export:android"
  },
  "dependencies": {
